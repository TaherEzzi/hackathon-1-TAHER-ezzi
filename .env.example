# Key names only — real values never leave .env.
# Never expose supabase_secret_key to the browser (no NEXT_PUBLIC_ prefix on it).

grok_api_key=
duffel_api_key=

# Supabase (project created 2026-10-26; schema applied — see supabase/migrations/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
supabase_secret_key=
SUPABASE_ACCESS_TOKEN=
